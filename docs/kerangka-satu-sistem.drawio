<mxCell id="c2" value="MODEL DATA SATU DATABASE (disederhanakan)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="44" as="geometry"/></mxCell>
<mxCell id="c3" value="Satu database untuk semua. Kunci penghubung: kode staff (contoh W24), kode PO, kode item / SKU, kode lokasi bin. Garis = relasi antar tabel." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1700" height="30" as="geometry"/></mxCell>
