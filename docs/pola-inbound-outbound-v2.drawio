<mxfile host="app.diagrams.net">
  <diagram id="pola-v2" name="Pola data Inbound dan Outbound V2">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t1" value="POLA DATA V2 (sama seperti Attendance): web sebagai tempat input, Google Sheets untuk angka, Google Drive untuk foto/video" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#7A3416;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell>

        <mxCell id="b1" value="&lt;b&gt;WEB WOS&lt;/b&gt;&lt;br&gt;Tim input di HP / PC&lt;br&gt;(unloading, GR, put away, picking, VP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#B5532A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;APPS SCRIPT&lt;/b&gt;&lt;br&gt;Pintu tunggal: cek token, kunci data, simpan, kirim balik&lt;br&gt;(menggantikan AppSheet sebagai perantara)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;GOOGLE SHEETS&lt;/b&gt;&lt;br&gt;Data angka dan status&lt;br&gt;(satu tab per jenis catatan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#548235;fontSize=13;" vertex="1" parent="1"><mxGeometry x="810" y="55" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;GOOGLE DRIVE&lt;/b&gt;&lt;br&gt;Foto dan video bukti&lt;br&gt;(folder kategori/bulan/pekan/hari)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="810" y="125" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;WEB: REKAP &amp; LAPORAN&lt;/b&gt;&lt;br&gt;Menarik data tiap 15-30 detik&lt;br&gt;ditampilkan ke SPV, admin, tim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#B5532A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1170" y="70" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="b2" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="b3" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="L1" value="FASE 1 - INBOUND: UNLOADING (penerimaan barang di web)" style="swimlane;horizontal=1;startSize=30;fillColor=#FBE5D6;strokeColor=#B5532A;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="1430" height="170" as="geometry"/></mxCell>
        <mxCell id="a1" value="Tim unloading isi form di web:&lt;br&gt;resi / PO / vendor / jumlah koli&lt;br&gt;+ foto surat jalan &amp; barang" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B5532A;" vertex="1" parent="L1"><mxGeometry x="20" y="50" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="a2" value="Tab UNLOADING&lt;br&gt;(satu baris per koli/dokumen,&lt;br&gt;id unik + waktu + PIC)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#D5E8D4;strokeColor=#548235;" vertex="1" parent="L1"><mxGeometry x="330" y="45" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="a3" value="Sistem cek kelengkapan dokumen:&lt;br&gt;PO, HPP, surat jalan, jumlah cocok" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;" vertex="1" parent="L1"><mxGeometry x="620" y="35" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="a4" value="OUTPUT: tab STAGING_IN&lt;br&gt;status Ready GR / Tidak ada HPP /&lt;br&gt;Menunggu dokumen" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#D5E8D4;strokeColor=#548235;fontStyle=1;" vertex="1" parent="L1"><mxGeometry x="950" y="45" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="a5" value="Rekap di web:&lt;br&gt;antrean Ready GR&lt;br&gt;+ umur unload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#B5532A;" vertex="1" parent="L1"><mxGeometry x="1240" y="50" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="ea1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="L1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="L1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="L1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="L1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="L2" value="FASE 2 - INBOUND: GR dan PUT AWAY" style="swimlane;horizontal=1;startSize=30;fillColor=#D5E8D4;strokeColor=#548235;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1430" height="170" as="geometry"/></mxCell>
        <mxCell id="g1" value="Web menampilkan hanya yang&lt;br&gt;STAGING_IN = Ready GR&lt;br&gt;(dokumen lengkap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;" vertex="1" parent="L2"><mxGeometry x="20" y="50" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="g2" value="Tim GR di web:&lt;br&gt;counting per PO/batch, koli, SKU, pcs&lt;br&gt;PIC counting + foto bila perlu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;" vertex="1" parent="L2"><mxGeometry x="310" y="50" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="g3" value="Tab GR (batch, koli, SKU, pcs, PIC)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#D5E8D4;strokeColor=#548235;" vertex="1" parent="L2"><mxGeometry x="620" y="45" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="g4" value="Put away di web:&lt;br&gt;barang disimpan di BIN mana&lt;br&gt;+ PIC put away" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;" vertex="1" parent="L2"><mxGeometry x="880" y="50" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="g5" value="OUTPUT: tab STOK_BIN&lt;br&gt;(riwayat mutasi masuk/keluar,&lt;br&gt;stok = jumlah mutasi)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#D5E8D4;strokeColor=#548235;fontStyle=1;" vertex="1" parent="L2"><mxGeometry x="1160" y="40" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="eg1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="L2" source="g1" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eg2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="L2" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eg3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="L2" source="g3" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eg4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="L2" source="g4" target="g5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="L3" value="FASE 3 - OUTBOUND (input: stok bin dari Inbound + SOQ dari PPIC)" style="swimlane;horizontal=1;startSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1430" height="190" as="geometry"/></mxCell>
        <mxCell id="o1" value="PPIC upload SOQ di web&lt;br&gt;(file Excel/CSV dibaca di web,&lt;br&gt;dicek lalu disimpan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="L3"><mxGeometry x="20" y="55" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="o2" value="Tab SOQ (outlet, batch, SKU, qty)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#D5E8D4;strokeColor=#548235;" vertex="1" parent="L3"><mxGeometry x="290" y="50" width="190" height="105" as="geometry"/></mxCell>
        <mxCell id="o3" value="Sistem otomatis:&lt;br&gt;cocokkan SOQ dengan STOK_BIN,&lt;br&gt;tentukan bin ambil, bagi ke picker" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;" vertex="1" parent="L3"><mxGeometry x="530" y="35" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="o4" value="Tab ASSIGNMENT&lt;br&gt;(picker, bin, koli)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#D5E8D4;strokeColor=#548235;" vertex="1" parent="L3"><mxGeometry x="850" y="50" width="170" height="105" as="geometry"/></mxCell>
        <mxCell id="o5" value="Picker di HP:&lt;br&gt;terima tugas, ACT picking,&lt;br&gt;VP, packing, TFS, driver&lt;br&gt;(foto/video bukti ke Drive)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="L3"><mxGeometry x="1070" y="45" width="190" height="120" as="geometry"/></mxCell>
        <mxCell id="o6" value="OUTPUT:&lt;br&gt;laporan outbound&lt;br&gt;+ stok keluar (mutasi)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#D5E8D4;strokeColor=#548235;fontStyle=1;" vertex="1" parent="L3"><mxGeometry x="1300" y="45" width="120" height="120" as="geometry"/></mxCell>
        <mxCell id="eo1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="L3" source="o1" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eo2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="L3" source="o2" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eo3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="L3" source="o3" target="o4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eo4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="L3" source="o4" target="o5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eo5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="L3" source="o5" target="o6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="lk1" value="STAGING_IN dibaca oleh GR" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B5532A;fontColor=#B5532A;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="lk2" value="STOK_BIN dibaca oleh Outbound" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B5532A;fontColor=#B5532A;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="n1" value="&lt;b&gt;ATURAN PENGAMAN DATA&lt;/b&gt;&lt;br&gt;1. Setiap catatan punya ID unik, jadi kirim ulang tidak membuat data ganda.&lt;br&gt;2. Apps Script mengunci penulisan, dua orang menulis bersamaan tetap aman.&lt;br&gt;3. Stok dihitung dari riwayat mutasi (masuk/keluar), bukan angka yang ditimpa.&lt;br&gt;4. Antrean offline di HP: sinyal putus, data dikirim ulang saat online.&lt;br&gt;5. Data lama diarsipkan per bulan agar Sheets tetap cepat." style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#F7EFE9;strokeColor=#B5532A;fontSize=12;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="700" height="150" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;CARA BERALIH&lt;/b&gt;&lt;br&gt;Modul lama tetap berjalan. Modul baru (Inbound V2 dan Outbound V2) dibuat berdampingan, diuji paralel per fase. Bila hasil sama dan tim nyaman, modul lama ditinggalkan.&lt;br&gt;&lt;b&gt;URUTAN:&lt;/b&gt; Fase 1 Unloading + Staging In, Fase 2 GR + Put away + Stok Bin, Fase 3 Outbound.&lt;br&gt;&lt;b&gt;BATAS:&lt;/b&gt; tidak realtime (jeda 15-30 detik); bila volume sangat besar atau perlu realtime penuh, tahap berikutnya pindah ke database (Supabase)." style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=12;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="780" y="820" width="690" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
