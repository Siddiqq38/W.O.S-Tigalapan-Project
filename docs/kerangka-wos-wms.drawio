<mxCell id="c3" value="WOS = EMPLOYEE (siapa, apa, berapa dikerjakan + hak dan kewajiban staff).  WMS = PRODUK (barang apa, berapa, dari mana, disimpan di mana, diambil dari mana, dikirim ke mana, dikerjakan oleh siapa)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1620" height="36" as="geometry"/></mxCell>
