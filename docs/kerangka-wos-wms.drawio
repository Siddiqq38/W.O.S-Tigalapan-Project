<mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;fontSize=11;" edge="1" parent="1" source="c21" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c32" value="CSV PO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;fontSize=11;" edge="1" parent="1" source="c18" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c33" value="Prinsip integrasi:&lt;br&gt;1. Satu data hanya punya satu pemilik; sisi lain membaca (tidak input ulang).&lt;br&gt;2. Kode staff adalah kunci yang sama di WOS dan WMS.&lt;br&gt;3. WOS tidak menyimpan stok; WMS tidak menyimpan absen, cuti, atau role.&lt;br&gt;4. Halaman Productivity WOS membaca aktivitas dari WMS (sementara masih membaca spreadsheet lama sampai integrasi selesai)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1250" height="120" as="geometry"/></mxCell>
</root></mxGraphModel></diagram><diagram name="5. Tahapan dan Pertanyaan" id="p5"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c2" value="TAHAPAN PENGEMBANGAN DAN PERTANYAAN TERBUKA" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="44" as="geometry"/></mxCell>
<mxCell id="c3" value="FASE 0 - Sekarang" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#404040;strokeColor=#404040;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="280" height="40" as="geometry"/></mxCell>
<mxCell id="c4" value="WOS: deploy Attendance (aturan 7 jam, kompensasi SPV, cuti, izin), Compliance, Productivity.`nWMS: deploy sendiri (inbound, outbound, unloading).`nModul Assignment dan Inbound Web di WOS ditahan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CBAD;strokeColor=#C55A11;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="280" height="190" as="geometry"/></mxCell>
<mxCell id="c5" value="FASE 1 - Samakan master" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#404040;strokeColor=#404040;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="280" height="40" as="geometry"/></mxCell>
<mxCell id="c6" value="Kode staff dan master karyawan disamakan (pemilik: WOS / HRD).`nWMS memakai kode staff yang sama.`nTentukan daftar role operasional." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#404040;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="120" width="280" height="190" as="geometry"/></mxCell>
<mxCell id="c7" value="FASE 2 - WOS ke WMS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#404040;strokeColor=#404040;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="280" height="40" as="geometry"/></mxCell>
<mxCell id="c8" value="Publish roster harian: hadir + role aktif + status cuti.`nWMS menampilkan staf standby per role." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BDD7EE;strokeColor=#2E75B6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="280" height="190" as="geometry"/></mxCell>
<mxCell id="c9" value="FASE 3 - WMS ke WOS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#404040;strokeColor=#404040;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="280" height="40" as="geometry"/></mxCell>
<mxCell id="c10" value="Aktivitas kerja dari WMS masuk ke Productivity (realtime + rekap).`nTemuan kesalahan masuk Compliance / Performance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BDD7EE;strokeColor=#2E75B6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="280" height="190" as="geometry"/></mxCell>
<mxCell id="c11" value="FASE 4 - Login tunggal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#404040;strokeColor=#404040;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1240" y="80" width="280" height="40" as="geometry"/></mxCell>
<mxCell id="c12" value="Satu akun untuk WOS dan WMS (Supabase Auth).`nHak akses per role disamakan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#7F7F7F;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1240" y="120" width="280" height="190" as="geometry"/></mxCell>
<mxCell id="c13" value="Pertanyaan terbuka (perlu diputuskan)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1480" height="36" as="geometry"/></mxCell>
<mxCell id="c14" value="Bentuk integrasi: API langsung, database Supabase bersama, atau file ekspor / impor terjadwal?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="1480" height="34" as="geometry"/></mxCell>
<mxCell id="c15" value="Realtime atau per beberapa menit untuk roster dan aktivitas?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="1480" height="34" as="geometry"/></mxCell>
<mxCell id="c16" value="Apakah task di WMS dibagi otomatis ke staf standby, atau admin yang memilih (atau keduanya)?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="458" width="1480" height="34" as="geometry"/></mxCell>
<mxCell id="c17" value="Daftar role operasional final dan batas role ganda per orang per hari." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="492" width="1480" height="34" as="geometry"/></mxCell>
<mxCell id="c18" value="Siapa pemilik master karyawan (HRD atau SPV) dan bagaimana staf baru ditambahkan di kedua sistem?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="526" width="1480" height="34" as="geometry"/></mxCell>
<mxCell id="c19" value="Bagaimana nasib halaman Productivity lama (spreadsheet) setelah integrasi: dihapus atau dibiarkan sebagai cadangan?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1480" height="34" as="geometry"/></mxCell>
<mxCell id="c20" value="Apakah PPIC, HRD, dan Finance login di WOS, WMS, atau keduanya?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="594" width="1480" height="34" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>