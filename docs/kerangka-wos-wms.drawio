<mxCell id="c188" value="Contoh role harian operasional (dipilih di WOS, terbaca di WMS):&lt;br&gt;Picker / Checker / Packer / Driver (outbound), Inbound (unloading, GR, put away), Storage Control, Admin Inbound, Admin Outbound, Admin ganda (Inbound + Outbound saat rekan cuti/off).&lt;br&gt;PPIC, HRD, Finance: akses terbatas sesuai fungsinya (PPIC = SOQ, HRD = master karyawan dan cuti, Finance = file HPP)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="980" height="90" as="geometry"/></mxCell>
</root></mxGraphModel></diagram><diagram name="4. Integrasi Data" id="p4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c2" value="INTEGRASI WOS - WMS (data apa mengalir ke mana)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="44" as="geometry"/></mxCell>
<mxCell id="c3" value="HRD (master karyawan, hak cuti)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#7F7F7F;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="170" height="46" as="geometry"/></mxCell>
<mxCell id="c4" value="Supervisor (alokasi role, approval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#7F7F7F;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="70" width="170" height="46" as="geometry"/></mxCell>
<mxCell id="c5" value="WOS (pemilik data EMPLOYEE)&lt;br&gt;&lt;br&gt;Karyawan dan status aktif&lt;br&gt;Kehadiran (in / out), jam kerja efektif&lt;br&gt;Lembur / SPL&lt;br&gt;Cuti, izin, Change Off&lt;br&gt;Role aktif harian&lt;br&gt;Compliance (5R, DRM, komplain)&lt;br&gt;Productivity, Performance, Coaching&lt;br&gt;Akun dan akses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E8;strokeColor=#C55A11;strokeWidth=2;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="400" height="600" as="geometry"/></mxCell>
<mxCell id="c6" value="LAPISAN BERSAMA (Supabase)&lt;br&gt;Login satu akun, kunci integrasi = KODE STAFF (contoh W24) + warehouse_id DC 38" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#7030A0;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="560" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="WOS ke WMS (event / API)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#548235;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="170" width="560" height="40" as="geometry"/></mxCell>
<mxCell id="c8" value="1. Master karyawan: kode staff, nama, status aktif" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560" y="210" width="560" height="34" as="geometry"/></mxCell>
<mxCell id="c9" value="2. Kehadiran hari ini: jam check in / out" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560" y="244" width="560" height="34" as="geometry"/></mxCell>
<mxCell id="c10" value="3. Role aktif harian (tunggal / ganda) dan pengganti" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560" y="278" width="560" height="34" as="geometry"/></mxCell>
<mxCell id="c11" value="4. Status cuti / izin / off (staf tidak masuk roster)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560" y="312" width="560" height="34" as="geometry"/></mxCell>
<mxCell id="c12" value="5. Jam kerja efektif dan lembur" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560" y="346" width="560" height="34" as="geometry"/></mxCell>
<mxCell id="c13" value="WMS ke WOS (event / API)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#548235;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="440" width="560" height="40" as="geometry"/></mxCell>
<mxCell id="c14" value="1. Aktivitas selesai: staff, aktivitas, task id, qty, mulai - selesai" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560" y="480" width="560" height="34" as="geometry"/></mxCell>
<mxCell id="c15" value="2. Status staf: standby / sibuk (realtime)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560" y="514" width="560" height="34" as="geometry"/></mxCell>
<mxCell id="c16" value="3. Temuan kesalahan: miss picking, selisih GR, report" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560" y="548" width="560" height="34" as="geometry"/></mxCell>
<mxCell id="c17" value="4. Beban task menunggu dan progres per rate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560" y="582" width="560" height="34" as="geometry"/></mxCell>
<mxCell id="c18" value="WMS (pemilik data PRODUK)&lt;br&gt;&lt;br&gt;Master item, SKU, lokasi bin&lt;br&gt;Stok per lokasi&lt;br&gt;Task queue (SOQ, PO inbound)&lt;br&gt;Inbound: unloading, staging, GR, put away&lt;br&gt;Outbound: picking, VP, packing, loading&lt;br&gt;Surat jalan dan HPP, CSV PO MOKA&lt;br&gt;Aktivitas kerja per staf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#2E75B6;strokeWidth=2;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1240" y="150" width="420" height="600" as="geometry"/></mxCell>
<mxCell id="c19" value="ERP (PO, master item)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#7F7F7F;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="130" height="46" as="geometry"/></mxCell>
<mxCell id="c20" value="PPIC (SOQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#7F7F7F;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1390" y="70" width="130" height="46" as="geometry"/></mxCell>
<mxCell id="c21" value="Finance (HPP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#7F7F7F;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1540" y="70" width="130" height="46" as="geometry"/></mxCell>
<mxCell id="c22" value="MOKA (upload PO CSV oleh admin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#7F7F7F;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1390" y="780" width="200" height="46" as="geometry"/></mxCell>
<mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#548235;fontSize=11;fontStyle=1;fontColor=#375623;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#548235;fontSize=11;fontStyle=1;fontColor=#375623;" edge="1" parent="1" source="c7" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#548235;fontSize=11;fontStyle=1;fontColor=#375623;" edge="1" parent="1" source="c18" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#548235;fontSize=11;fontStyle=1;fontColor=#375623;" edge="1" parent="1" source="c13" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;fontSize=11;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;fontSize=11;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;fontSize=11;" edge="1" parent="1" source="c19" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell>
